# Only needed when rad_data.json has "auth_mode": "oidc" (single sign-on). Copy to secrets.toml; never commit that file.
# IT supplies the values from the organisation's identity provider. Needs Streamlit 1.42 or newer.
[auth]
redirect_uri = "https://rad-data.example.org/oauth2callback"
cookie_secret = "replace-with-a-long-random-string"
client_id = "replace"
client_secret = "replace"
server_metadata_url = "https://login.example.org/.well-known/openid-configuration"
